<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tactrix OpenPort 2.0. VID=0x0403 (FTDI), PID=0xCC4D (Tactrix-specific).
      Declared in decimal here because that's what the USB host stack returns
      in UsbDevice.vendorId / productId — and what we already compare against
      in Protocol.kt (TACTRIX_VENDOR_ID = 1027, TACTRIX_PRODUCT_ID = 52301).
    -->
    <usb-device vendor-id="1027" product-id="52301" />
    <!--
      OBDLink EX. FTDI FT231X in VCP mode: VID=0x0403 (FTDI, 1027),
      PID=0x6015 (24597). Same STN2120 command set as the MX+, reached over
      a hand-rolled FTDI USB-serial transport (FtdiUsbSerial).
    -->
    <usb-device vendor-id="1027" product-id="24597" />
</resources>
