<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Localhost TCP via `adb reverse` for bench-test paths. No real network use. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- OBDLink MX+ (Bluetooth). Connect to an already-paired adapter only, so
         no scan/location permission is needed. BLUETOOTH_CONNECT is the runtime
         permission on API 31+; the legacy ones cover API <= 30. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <activity
            android:name=".protocol.Protocol"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              USB device-attached filter for the Tactrix OpenPort 2.0.
              When the user checks "always open with PROTOCOL" on the first
              plug-in, Android grants permission persistently — no permission
              dialog on subsequent re-plugs.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

            <!--
              Receive a kernel image shared or opened into PROTOCOL ("Share ->
              PROTOCOL" or "Open with") — e.g. one received over WhatsApp/email
              that the messaging app won't let you save as a raw .bin. Android
              can't reliably filter content URIs by extension, so this matches the
              binary MIME (application/octet-stream), which covers .bin/.hex; the
              Activity imports the bytes as the selected firmware-read kernel.
              (.csv/.json handlers arrive with the data-import reform.)
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
